                "glue:GetCatalog",
                "glue:GetDatabase",
                "glue:GetDatabases",
                "glue:GetTable",
                "glue:GetTables",
                "glue:CreateTable",
                "glue:UpdateTable",
                "glue:DeleteTable"
            ],
            "Resource": [
                "arn:aws:glue:us-west-2:484577546576:catalog",
                "arn:aws:glue:us-west-2:484577546576:database/rivdemo_2026",
                "arn:aws:glue:us-west-2:484577546576:table/rivdemo_2026/*"
            ]
        },
